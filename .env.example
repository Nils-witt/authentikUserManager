AUTHENTIK_URL=https://sso.nils-witt.de
# Token of a user/service account allowed to view, add, change and delete users.
AUTHENTIK_TOKEN=
LISTEN_ADDR=127.0.0.1:8080
# STATIC_DIR=frontend/dist

# OIDC login (authentik OAuth2/OpenID provider for this app)
OIDC_ISSUER=https://sso.nils-witt.de/application/o/authentik-manager/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Development via Vite: http://localhost:5173/auth/callback
OIDC_REDIRECT_URL=https://manager.example.com/auth/callback

# PostgreSQL storing the access rules (make dev-db starts this one).
DATABASE_URL=postgres://authentik_manager:authentik_manager@127.0.0.1:5432/authentik_manager?sslmode=disable
# Comma-separated groups with full access that may edit the access rules in the UI.
ACCESS_ADMIN_GROUPS=authentik Admins
