AUTHENTIK_URL=https://sso.nils-witt.de
# Token of a user/service account allowed to view, add, change and delete users.
AUTHENTIK_TOKEN=
LISTEN_ADDR=127.0.0.1:8080
# STATIC_DIR=frontend/dist
# UUID of the email stage that sends password recovery emails (Flows and Stages → Stages).
# Leave unset to disable the "Send recovery email" action.
# AUTHENTIK_RECOVERY_EMAIL_STAGE=

# OIDC login (authentik OAuth2/OpenID provider for this app)
OIDC_ISSUER=https://sso.nils-witt.de/application/o/authentik-manager/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Development via Vite: http://localhost:5173/auth/callback
OIDC_REDIRECT_URL=https://manager.example.com/auth/callback

# PostgreSQL storing the access rules and the audit log (make dev-db starts this one).
DATABASE_URL=postgres://authentik_manager:authentik_manager@127.0.0.1:5432/authentik_manager?sslmode=disable
# Days to keep audit log entries; they are kept forever when unset.
# AUDIT_RETENTION_DAYS=365
# Comma-separated groups with full access that may edit the access rules in the UI.
ACCESS_ADMIN_GROUPS=authentik Admins

# Client certificates for users, signed by this CA (PEM files). Leave unset to disable them.
# make example-ca creates one in ca/ for development.
# CA_CERT_FILE=/etc/authentik-manager/ca.crt
# CA_KEY_FILE=/etc/authentik-manager/ca.key
# CERT_VALIDITY_DAYS=365
# Public URL of this app's CRL, embedded in issued certificates.
# CERT_CRL_URL=https://manager.example.com/pki/crl
# Days each CRL is valid until its next update.
# CERT_CRL_VALIDITY_DAYS=30
# Appended to the username in the common name of user certificates, e.g. ann@example.com.
# CERT_USER_CN_SUFFIX=@example.com
# The same for service account certificates.
# CERT_SERVICE_ACCOUNT_CN_SUFFIX=@svc.example.com
